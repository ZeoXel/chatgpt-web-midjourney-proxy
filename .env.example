# Vercel 生产环境配置示例
# 在 Vercel Dashboard 中配置这些环境变量

# 核心认证密钥（可选，如果配置则需要前端传递 x-ptoken 头）
AUTH_SECRET_KEY=your-secret-key

# OpenAI 配置
OPENAI_API_KEY=your-openai-api-key
OPENAI_API_BASE_URL=https://api.openai.com

# Midjourney 配置
MJ_SERVER=https://your-mj-server.com
MJ_API_SECRET=your-mj-secret

# Suno 音乐生成
SUNO_SERVER=https://your-suno-server.com
SUNO_KEY=your-suno-key

# Luma 视频生成
LUMA_SERVER=https://your-luma-server.com
LUMA_KEY=your-luma-key

# Vidu 视频生成
VIDU_SERVER=https://api.vidu.cn
VIDU_KEY=your-vidu-key

# MiniMax 视频生成
MINIMAX_SERVER=https://api.minimax.chat
MINIMAX_KEY=your-minimax-key

# Viggle 动画生成
VIGGLE_SERVER=https://your-viggle-server.com
VIGGLE_KEY=your-viggle-key

# Runway ML 视频生成
RUNWAYML_SERVER=https://api.runwayml.com
RUNWAYML_KEY=your-runwayml-key

# Runway 视频生成
RUNWAY_SERVER=https://your-runway-server.com
RUNWAY_KEY=your-runway-key

# Kling 视频生成
KLING_SERVER=https://your-kling-server.com
KLING_KEY=your-kling-key

# Ideogram 图像生成
IDEOGRAM_SERVER=https://your-ideogram-server.com
IDEOGRAM_KEY=your-ideogram-key

# Pika 视频生成
PIKA_SERVER=https://your-pika-server.com
PIKA_KEY=your-pika-key

# Udio 音乐生成
UDIO_SERVER=https://your-udio-server.com
UDIO_KEY=your-udio-key

# Pixverse 视频生成
PIXVERSE_SERVER=https://your-pixverse-server.com
PIXVERSE_KEY=your-pixverse-key

# ===== 文件上传配置 =====
# Cloudflare R2 云存储（推荐用于生产环境）
# 开发阶段默认关闭，如需开启设置为 true
ENABLE_CLOUD_STORAGE=false
R2_ACCOUNT_ID=your-r2-account-id
R2_KEY_ID=your-r2-access-key-id
R2_KEY_SECRET=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_DOMAIN=https://your-domain.com

# ===== 腾讯云COS配置 =====
# 开发阶段可以开启测试，设置为 true 启用
ENABLE_TENCENT_COS=false
COS_SECRET_ID=your-tencent-cos-secret-id
COS_SECRET_KEY=your-tencent-cos-secret-key
COS_BUCKET=your-bucket-name-appid
COS_REGION=ap-guangzhou
COS_DOMAIN=https://your-cos-domain.com

# 资产处理功能（自动下载外部图片/视频/音频并上传到COS）
# 设置为 false 可以禁用资产处理，只保存对话文本
ENABLE_ASSET_PROCESSING=true

# ===== 数据库存储配置 =====
# 开发阶段默认关闭，如需接入 Supabase 数据库请设为 true
ENABLE_DATABASE=false
# Supabase 上传中转在未使用数据库时依然可用，如需彻底关闭上传将其设为 false
ENABLE_SUPABASE_UPLOAD=true
# SUPABASE_URL=https://your-supabase-project.supabase.co
# SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# 外部文件服务器（可选）
FILE_SERVER=https://your-file-server.com/upload
API_UPLOADER=true

# 公网访问 URL（用于生成可访问的文件链接）
PUBLIC_URL=https://your-public-domain.com
