# OpenAI API配置
OPENAI_API_KEY=sk-xxx
OPENAI_API_BASE_URL=http://localhost:3000

# 本地开发：内网穿透公网URL（用于图片访问）
# 使用 ngrok: ngrok http 9005
# 使用 cloudflared: cloudflared tunnel --url http://localhost:9005
# 使用 localtunnel: lt --port 9005
# 示例：PUBLIC_URL=https://abc123.ngrok.io

# 生产环境：使用实际的公网域名
# 示例：PUBLIC_URL=https://your-domain.com
PUBLIC_URL=

# Supabase数据库配置（多平台数据同步）
# 获取方式：Supabase项目 → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxx

# 其他配置...
