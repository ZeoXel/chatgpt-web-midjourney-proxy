# Glob API URL
VITE_GLOB_API_URL=/api

VITE_APP_API_BASE_URL=http://localhost:3002

# Whether long replies are supported, which may result in higher API fees
VITE_GLOB_OPEN_LONG_REPLY=false

# When you want to use PWA
VITE_GLOB_APP_PWA=false

# Vidu配置
VIDU_SERVER=https://api.vidu.cn
VIDU_KEY=your_vidu_key_here

# Supabase配置
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_KEY=your_supabase_key_here

# 腾讯云COS存储配置
ENABLE_TENCENT_COS=true
COS_SECRET_ID=your_cos_secret_id_here
COS_SECRET_KEY=your_cos_secret_key_here
COS_BUCKET=your_bucket_name_here
COS_REGION=ap-beijing
COS_DOMAIN=https://your-cos-domain.com
