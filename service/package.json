{
  "name": "chatgpt-web-service",
  "version": "2.15.6",
  "private": false,
  "description": "ChatGPT Web Midjourney Proxy",
  "author": "ChenZhaoYu <ydlhero@gmail.com>",
  "keywords": [
    "chatgpt-web",
    "chatgpt",
    "chatbot",
    "express"
  ],
  "engines": {
    "node": "^16 || ^18 || ^19"
  },
  "scripts": {
    "start": "esno ./src/index.ts",
    "dev": "esno watch ./src/index.ts",
    "prod": "node ./build/index.mjs",
    "build": "pnpm clean && tsup",
    "clean": "rimraf build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "common:cleanup": "rimraf node_modules && rimraf pnpm-lock.yaml",
    "setup:supabase": "esno ./src/scripts/setup-supabase.ts",
    "test:supabase": "esno ./src/scripts/test-supabase-connection.ts",
    "query:supabase": "esno ./src/scripts/query-supabase-data.ts",
    "test:assets": "esno ./src/scripts/test-assets-api.ts",
    "test:cos": "esno ./test-cos-connection.ts",
    "inspect:cos": "esno ./inspect-cos-bucket.ts",
    "test:upload": "esno ./test-upload-integration.ts",
    "test:chat-storage": "esno ./test-chat-storage-api.ts",
    "add-indexes": "esno ./src/scripts/add-performance-indexes.ts",
    "benchmark:query": "esno ./src/scripts/benchmark-query-performance.ts",
    "check:apikey": "esno ./src/scripts/check-api-key.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.76.1",
    "aws-sdk": "^2.1535.0",
    "axios": "^1.3.4",
    "body-parser": "^1.20.2",
    "chatgpt": "^5.1.2",
    "cos-nodejs-sdk-v5": "^2.15.4",
    "dotenv": "^16.0.3",
    "esno": "^0.16.3",
    "express": "^4.18.2",
    "express-http-proxy": "^2.0.0",
    "express-rate-limit": "^6.7.0",
    "form-data": "^4.0.0",
    "http-proxy-middleware": "^2.0.6",
    "https-proxy-agent": "^5.0.1",
    "isomorphic-fetch": "^3.0.0",
    "md5": "^2.3.0",
    "multer": "1.4.5-lts.1",
    "node-fetch": "^3.3.0",
    "pako": "^2.1.0",
    "pg": "^8.16.3",
    "socks-proxy-agent": "^7.0.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^0.35.3",
    "@types/express": "^4.17.17",
    "@types/node": "^18.14.6",
    "@types/pako": "^2.0.4",
    "eslint": "^8.35.0",
    "rimraf": "^4.3.0",
    "tsup": "^6.6.3",
    "typescript": "^4.9.5"
  }
}
